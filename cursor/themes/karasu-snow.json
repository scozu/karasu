{
  "$schema": "vscode://schemas/color-theme",
  "name": "Karasu Snow",
  "type": "light",
  "colors": {
    "editor.background": "#f8f7f6",
    "editor.foreground": "#3c3836",
    "editorLineNumber.foreground": "#7c6f64",
    "editorLineNumber.activeForeground": "#c4a657",
    "editor.selectionBackground": "#d6d4d1",
    "editor.selectionHighlightBackground": "#d6d4d1",
    "editor.inactiveSelectionBackground": "#d6d4d1",
    "editorCursor.foreground": "#c4a657",
    "editorWhitespace.foreground": "#dfdddb",
    "editorIndentGuide.background": "#dfdddb",
    "editorIndentGuide.activeBackground": "#e5e3e2",
    "editor.findMatchBackground": "#cdc9c5",
    "editor.findMatchHighlightBackground": "#e5e3e2",
    "editorBracketMatch.background": "#e5e3e2",
    "editorBracketMatch.border": "#7c9fa8",
    "editor.lineHighlightBackground": "#f1f0ef",
    "editor.wordHighlightBackground": "#d6d4d1",
    "editor.wordHighlightStrongBackground": "#d6d4d1",
    "editorError.foreground": "#c4746e",
    "editorWarning.foreground": "#c4a657",
    "editorInfo.foreground": "#7c9fa8",
    "editorHint.foreground": "#7c6f64",
    "editorError.border": "#c4746e",
    "editorWarning.border": "#c4a657",
    "editorInfo.border": "#7c9fa8",
    "editorHint.border": "#7c6f64",
    "sideBar.background": "#f1f0ef",
    "sideBar.foreground": "#3c3836",
    "sideBarTitle.foreground": "#3c3836",
    "sideBarSectionHeader.background": "#f1f0ef",
    "sideBarSectionHeader.foreground": "#665c54",
    "activityBar.background": "#f8f7f6",
    "activityBar.foreground": "#3c3836",
    "activityBarBadge.background": "#7c9fa8",
    "activityBarBadge.foreground": "#f8f7f6",
    "statusBar.background": "#f1f0ef",
    "statusBar.foreground": "#504945",
    "statusBar.noFolderBackground": "#f1f0ef",
    "statusBar.debuggingBackground": "#c4746e",
    "statusBarItem.prominentBackground": "#e5e3e2",
    "statusBarItem.prominentHoverBackground": "#dfdddb",
    "titleBar.activeBackground": "#f8f7f6",
    "titleBar.activeForeground": "#3c3836",
    "titleBar.inactiveBackground": "#f1f0ef",
    "titleBar.inactiveForeground": "#7c6f64",
    "tab.activeBackground": "#e5e3e2",
    "tab.activeForeground": "#3c3836",
    "tab.inactiveBackground": "#f1f0ef",
    "tab.inactiveForeground": "#7c6f64",
    "tab.border": "#f1f0ef",
    "tab.activeBorder": "#7c9fa8",
    "breadcrumb.foreground": "#665c54",
    "breadcrumb.activeSelectionForeground": "#3c3836",
    "breadcrumb.focusForeground": "#3c3836",
    "list.activeSelectionBackground": "#d6d4d1",
    "list.activeSelectionForeground": "#3c3836",
    "list.inactiveSelectionBackground": "#e5e3e2",
    "list.hoverBackground": "#f1f0ef",
    "list.focusBackground": "#d6d4d1",
    "input.background": "#f1f0ef",
    "input.foreground": "#3c3836",
    "input.border": "#dfdddb",
    "inputOption.activeBorder": "#7c9fa8",
    "dropdown.background": "#e5e3e2",
    "dropdown.foreground": "#3c3836",
    "dropdown.border": "#dfdddb",
    "button.background": "#e5e3e2",
    "button.foreground": "#3c3836",
    "button.hoverBackground": "#dfdddb",
    "button.secondaryBackground": "#e5e3e2",
    "button.secondaryForeground": "#3c3836",
    "button.secondaryHoverBackground": "#dfdddb",
    "panel.background": "#f8f7f6",
    "panel.border": "#dfdddb",
    "panelTitle.activeForeground": "#3c3836",
    "panelTitle.inactiveForeground": "#7c6f64",
    "terminal.background": "#f8f7f6",
    "terminal.foreground": "#3c3836",
    "terminal.ansiBlack": "#f8f7f6",
    "terminal.ansiRed": "#c4746e",
    "terminal.ansiGreen": "#95b572",
    "terminal.ansiYellow": "#c4a657",
    "terminal.ansiBlue": "#7c9fa8",
    "terminal.ansiMagenta": "#a987a8",
    "terminal.ansiCyan": "#85a585",
    "terminal.ansiWhite": "#3c3836",
    "terminal.ansiBrightBlack": "#928374",
    "terminal.ansiBrightRed": "#cc241d",
    "terminal.ansiBrightGreen": "#98971a",
    "terminal.ansiBrightYellow": "#d79921",
    "terminal.ansiBrightBlue": "#458588",
    "terminal.ansiBrightMagenta": "#b16286",
    "terminal.ansiBrightCyan": "#689d6a",
    "terminal.ansiBrightWhite": "#504945",
    "gitDecoration.addedResourceForeground": "#95b572",
    "gitDecoration.modifiedResourceForeground": "#c4a657",
    "gitDecoration.deletedResourceForeground": "#c4746e",
    "gitDecoration.untrackedResourceForeground": "#85a585",
    "gitDecoration.ignoredResourceForeground": "#928374",
    "gitDecoration.conflictingResourceForeground": "#d6936b",
    "diffEditor.insertedTextBackground": "#95b57220",
    "diffEditor.removedTextBackground": "#c4746e20",
    "scrollbarSlider.background": "#dfdddb80",
    "scrollbarSlider.hoverBackground": "#e5e3e280",
    "scrollbarSlider.activeBackground": "#e5e3e2"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#95b572"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#c4a657"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#a987a8"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#7c9fa8"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.type"],
      "settings": {
        "foreground": "#85a585"
      }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": {
        "foreground": "#3c3836"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#d6936b"
      }
    },
    {
      "scope": ["entity.name.tag", "entity.other.attribute-name"],
      "settings": {
        "foreground": "#d6936b"
      }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#665c54"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#d6936b"
      }
    },
    {
      "scope": ["entity.name.property"],
      "settings": {
        "foreground": "#504945"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#c4746e"
      }
    },
    {
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#7c9fa8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.underline"],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#95b572"
      }
    },
    {
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#665c54"
      }
    },
    {
      "scope": ["markup.list"],
      "settings": {
        "foreground": "#3c3836"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#a987a8",
    "string": "#95b572",
    "function": "#7c9fa8",
    "variable": "#3c3836",
    "type": "#85a585",
    "class": "#85a585",
    "enum": "#85a585",
    "interface": "#85a585",
    "namespace": "#85a585",
    "parameter": "#d6936b",
    "property": "#504945",
    "enumMember": "#c4a657",
    "decorator": "#85a585",
    "event": "#7c9fa8",
    "method": "#7c9fa8",
    "macro": "#85a585",
    "comment": "#928374",
    "number": "#c4a657",
    "regexp": "#95b572",
    "operator": "#d6936b"
  }
}