{
  "name": "Karasu Snow",
  "type": "light",
  "colors": {
    "editor.background": "#f8f7f6",
    "editor.foreground": "#3c3836",
    "editorCursor.foreground": "#d79921",
    "editorCursor.background": "#f8f7f6",
    "editor.selectionBackground": "#d6d4d1",
    "editor.selectionForeground": "#3c3836",
    "editor.lineHighlightBackground": "#f1f0ef",
    "editorLineNumber.foreground": "#7c6f64",
    "editorLineNumber.activeForeground": "#c4a657",
    "editorIndentGuide.background": "#e5e3e2",
    "editorIndentGuide.activeBackground": "#dfdddb",
    "editorGroup.border": "#e5e3e2",
    "editorWidget.background": "#f1f0ef",
    "sideBar.background": "#f1f0ef",
    "sideBar.foreground": "#504945",
    "activityBar.background": "#f1f0ef",
    "activityBar.foreground": "#3c3836",
    "statusBar.background": "#f1f0ef",
    "statusBar.foreground": "#504945",
    "tab.activeBackground": "#ebe9e8",
    "tab.inactiveBackground": "#f1f0ef",
    "terminal.ansiBlack": "#f8f7f6",
    "terminal.ansiRed": "#c4746e",
    "terminal.ansiGreen": "#95b572",
    "terminal.ansiYellow": "#c4a657",
    "terminal.ansiBlue": "#7c9fa8",
    "terminal.ansiMagenta": "#a987a8",
    "terminal.ansiCyan": "#85a585",
    "terminal.ansiWhite": "#3c3836",
    "terminal.ansiBrightBlack": "#928374",
    "terminal.ansiBrightRed": "#cc241d",
    "terminal.ansiBrightGreen": "#98971a",
    "terminal.ansiBrightYellow": "#d79921",
    "terminal.ansiBrightBlue": "#458588",
    "terminal.ansiBrightMagenta": "#b16286",
    "terminal.ansiBrightCyan": "#689d6a",
    "terminal.ansiBrightWhite": "#504945"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#95b572"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#a987a8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7c9fa8"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#3c3836"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#c4a657"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#85a585"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#d6936b"
      }
    }
  ]
}
