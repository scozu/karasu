{
  "name": "karasu-theme",
  "displayName": "Karasu Theme",
  "description": "Karasu is an atmospheric terminal-first theme for VS Code with Night and Snow variants.",
  "version": "0.2.0",
  "publisher": "scozu",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/scozu/karasu/tree/main/platforms/vscode",
  "bugs": {
    "url": "https://github.com/scozu/karasu/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scozu/karasu.git"
  },
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "karasu",
    "theme",
    "color theme",
    "dark theme",
    "light theme",
    "night",
    "snow",
    "gruvbox",
    "kanagawa",
    "cursor"
  ],
  "scripts": {
    "build:themes": "cd ../.. && bun run ./scripts/build-themes.mjs",
    "check:vscode": "cd ../.. && bun run ./scripts/check-vscode-theme.mjs",
    "check:consistency": "cd ../.. && bun run ./scripts/check-consistency.mjs",
    "package": "bun run build:themes && bun run check:consistency && bun run check:vscode && bun x @vscode/vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "release:check": "bun run build:themes && bun run check:consistency && bun run check:vscode"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1",
    "ovsx": "^0.10.9"
  },
  "contributes": {
    "themes": [
      {
        "label": "Karasu Night",
        "uiTheme": "vs-dark",
        "path": "./themes/karasu-night-color-theme.json"
      },
      {
        "label": "Karasu Snow",
        "uiTheme": "vs",
        "path": "./themes/karasu-snow-color-theme.json"
      }
    ]
  }
}
