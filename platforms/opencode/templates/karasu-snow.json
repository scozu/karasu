{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "karasuBg0": "{{karasuBg0}}",
    "karasuBg1": "{{karasuBg1}}",
    "karasuBg2": "{{karasuBg2}}",
    "karasuBg3": "{{karasuBg3}}",
    "karasuBg4": "{{karasuBg4}}",
    "karasuBgVisual": "{{karasuBgVisual}}",
    "karasuBgSearch": "{{karasuBgSearch}}",
    "karasuFg0": "{{karasuFg0}}",
    "karasuFg1": "{{karasuFg1}}",
    "karasuFg2": "{{karasuFg2}}",
    "karasuFg3": "{{karasuFg3}}",
    "karasuFgDim": "{{karasuFgDim}}",
    "karasuRed": "{{karasuRed}}",
    "karasuGreen": "{{karasuGreen}}",
    "karasuYellow": "{{karasuYellow}}",
    "karasuBlue": "{{karasuBlue}}",
    "karasuPurple": "{{karasuPurple}}",
    "karasuAqua": "{{karasuAqua}}",
    "karasuOrange": "{{karasuOrange}}",
    "karasuBrightRed": "{{karasuBrightRed}}",
    "karasuBrightGreen": "{{karasuBrightGreen}}",
    "karasuBrightYellow": "{{karasuBrightYellow}}",
    "karasuBrightBlue": "{{karasuBrightBlue}}",
    "karasuBrightMagenta": "{{karasuBrightMagenta}}",
    "karasuBrightCyan": "{{karasuBrightCyan}}",
    "karasuBrightWhite": "{{karasuBrightWhite}}"
  },
  "theme": {
    "primary": {
      "dark": "syntaxProperty",
      "light": "syntaxProperty"
    },
    "secondary": {
      "dark": "syntaxNumber",
      "light": "syntaxNumber"
    },
    "accent": {
      "dark": "syntaxString",
      "light": "syntaxString"
    },
    "error": {
      "dark": "diagError",
      "light": "diagError"
    },
    "warning": {
      "dark": "diagWarning",
      "light": "diagWarning"
    },
    "success": {
      "dark": "syntaxFunction",
      "light": "syntaxFunction"
    },
    "info": {
      "dark": "diagInfo",
      "light": "diagInfo"
    },
    "text": {
      "dark": "syntaxVariable",
      "light": "syntaxVariable"
    },
    "textMuted": {
      "dark": "syntaxComment",
      "light": "syntaxComment"
    },
    "background": {
      "dark": "karasuBg0",
      "light": "karasuFg0"
    },
    "backgroundPanel": {
      "dark": "karasuBg1",
      "light": "karasuFg1"
    },
    "backgroundElement": {
      "dark": "karasuBg2",
      "light": "karasuFg2"
    },
    "border": {
      "dark": "karasuBg3",
      "light": "karasuFg3"
    },
    "borderActive": {
      "dark": "syntaxProperty",
      "light": "syntaxProperty"
    },
    "borderSubtle": {
      "dark": "karasuBg2",
      "light": "karasuFg2"
    },
    "diffAdded": {
      "dark": "syntaxFunction",
      "light": "syntaxFunction"
    },
    "diffRemoved": {
      "dark": "diagError",
      "light": "diagError"
    },
    "diffContext": {
      "dark": "syntaxComment",
      "light": "syntaxComment"
    },
    "diffHunkHeader": {
      "dark": "karasuBg3",
      "light": "karasuFg3"
    },
    "diffHighlightAdded": {
      "dark": "syntaxFunction",
      "light": "syntaxFunction"
    },
    "diffHighlightRemoved": {
      "dark": "diagError",
      "light": "diagError"
    },
    "diffAddedBg": {
      "dark": "diffAddedBg",
      "light": "diffAddedBg"
    },
    "diffRemovedBg": {
      "dark": "diffRemovedBg",
      "light": "diffRemovedBg"
    },
    "diffContextBg": {
      "dark": "diffContextBg",
      "light": "diffContextBg"
    },
    "diffLineNumber": {
      "dark": "syntaxComment",
      "light": "syntaxComment"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddedBg",
      "light": "diffAddedBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffRemovedBg",
      "light": "diffRemovedBg"
    },
    "markdownText": {
      "dark": "karasuFg0",
      "light": "karasuBg0"
    },
    "markdownHeading": {
      "dark": "syntaxLink",
      "light": "syntaxLink"
    },
    "markdownLink": {
      "dark": "syntaxLink",
      "light": "syntaxLink"
    },
    "markdownLinkText": {
      "dark": "syntaxProperty",
      "light": "syntaxProperty"
    },
    "markdownCode": {
      "dark": "syntaxString",
      "light": "syntaxString"
    },
    "markdownBlockQuote": {
      "dark": "syntaxComment",
      "light": "syntaxComment"
    },
    "markdownEmph": {
      "dark": "syntaxKeyword",
      "light": "syntaxKeyword"
    },
    "markdownStrong": {
      "dark": "syntaxOperator",
      "light": "syntaxOperator"
    },
    "markdownHorizontalRule": {
      "dark": "karasuBg3",
      "light": "karasuFg3"
    },
    "markdownListItem": {
      "dark": "syntaxProperty",
      "light": "syntaxProperty"
    },
    "markdownListEnumeration": {
      "dark": "syntaxNumber",
      "light": "syntaxNumber"
    },
    "markdownImage": {
      "dark": "syntaxLink",
      "light": "syntaxLink"
    },
    "markdownImageText": {
      "dark": "syntaxProperty",
      "light": "syntaxProperty"
    },
    "markdownCodeBlock": {
      "dark": "karasuFg0",
      "light": "karasuBg0"
    },
    "syntaxComment": {
      "dark": "syntaxComment",
      "light": "syntaxComment"
    },
    "syntaxKeyword": {
      "dark": "syntaxKeyword",
      "light": "syntaxKeyword"
    },
    "syntaxFunction": {
      "dark": "syntaxFunction",
      "light": "syntaxFunction"
    },
    "syntaxVariable": {
      "dark": "syntaxVariable",
      "light": "syntaxVariable"
    },
    "syntaxString": {
      "dark": "syntaxString",
      "light": "syntaxString"
    },
    "syntaxNumber": {
      "dark": "syntaxNumber",
      "light": "syntaxNumber"
    },
    "syntaxType": {
      "dark": "syntaxType",
      "light": "syntaxType"
    },
    "syntaxOperator": {
      "dark": "syntaxOperator",
      "light": "syntaxOperator"
    },
    "syntaxPunctuation": {
      "dark": "syntaxPunctuation",
      "light": "syntaxPunctuation"
    },
    "cursor": {
      "dark": "cursor",
      "light": "cursor"
    }
  }
}
